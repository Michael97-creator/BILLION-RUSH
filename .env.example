# Player-safe values only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# NEVER expose the service role key in apps/player or apps/studio static assets.
# Supabase Edge Function secrets (server-side only; NEVER expose these in the browser)
OPENAI_API_KEY=
OPENAI_MODEL=

# Free AI is configured ONLY as a Supabase Edge Function secret; never expose it in the browser.
# GEMINI_API_KEY=your_google_ai_studio_key
# GEMINI_MODEL=gemini-2.5-flash-lite

